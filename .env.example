# Hostname for the Vue frontend (used by the reverse proxy)
FRONTEND_HOST=home-planner.localhost

# Hostname for the PocketBase API.
# Used both by the reverse proxy and, at frontend container startup, to build the
# runtime PocketBase URL
POCKETBASE_HOST=pb.home-planner.localhost

# Scheme for the runtime PocketBase URL (https://$POCKETBASE_HOST).
# The local Docker stack runs HTTP-only, so use http here; set to https in
# production deployments behind TLS.
POCKETBASE_SCHEME=http
